APP_NAME=telegram-engine
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/telegram_engine.db
# MySQL externo (no se levanta en Docker):
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/telegram_engine
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=replace-me
SESSION_STORE_PATH=./data/sessions
SESSION_ENCRYPTION_KEY=generate-with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTERNAL_API_KEY=replace-with-a-long-random-key
INCOMING_WEBHOOK_URL=https://example.com/incoming
